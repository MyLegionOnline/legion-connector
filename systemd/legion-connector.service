[Unit]
Description=Legion Hub connector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# install.sh fills in the real user/paths; this template assumes the
# connector was installed under the invoking user's home directory.
User=%i
WorkingDirectory=/opt/legion-connector
ExecStart=/usr/bin/node /opt/legion-connector/dist/index.js start
Restart=always
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
