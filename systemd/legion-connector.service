[Unit]
Description=Legion Hub connector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# install.sh fills in the dedicated user (legion-agent by default) and the
# path of node; the connector keeps its state in that user's home.
User=%i
WorkingDirectory=/opt/legion-connector
ExecStart=/usr/bin/node /opt/legion-connector/dist/index.js start
Restart=always
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
